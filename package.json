{
  "name": "@geckou/vue-ui",
  "version": "0.2.3",
  "description": "A set of reusable Vue UI components (forms & article lists) by Geckou",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckou/vue-ui.git"
  },
  "author": "geckou-shogo <shogo.nojima@geckou.net>",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.27.0",
    "sass": "^1.83.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^4.4.0",
    "vue": "^3.5.13"
  },
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "convert-alias": "node scripts/convert-alias-to-relative.js",
    "build": "yarn clean && rsync -av --exclude 'main.ts' --exclude 'App.vue' --exclude '.DS_Store' src/ dist/ && yarn convert-alias",
    "build:demo": "vite build",
    "preview:demo": "vite preview",
    "lint": "eslint src demo --ext .ts,.vue",
    "prepublishOnly": "yarn build",
    "release": "bash scripts/release.sh",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  },
  "homepage": "https://ui.geckou.net/",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "form",
    "article-list",
    "wordpress"
  ],
  "bugs": {
    "url": "https://github.com/geckou/vue-ui/issues"
  }
}
